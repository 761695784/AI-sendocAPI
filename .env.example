APP_NAME=DocTrack
APP_ENV=local
APP_KEY=
# Toujours false en production (sinon les erreurs internes sont exposées)
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# sync tant qu'aucun worker (php artisan queue:work) ne tourne sur le serveur,
# sinon correspondances, SMS et emails restent en attente dans la table jobs.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Emails : « log » = écrits dans storage/logs/laravel.log (rien ne part).
# Pour de vrais envois avec une boîte Hostinger (ex. noreply@majeliconnect.com) :
#   MAIL_MAILER=smtp  MAIL_HOST=smtp.hostinger.com  MAIL_PORT=465  MAIL_ENCRYPTION=ssl
#   MAIL_USERNAME=<adresse complète>  MAIL_PASSWORD=<mot de passe de la boîte>  MAIL_FROM_ADDRESS=<même adresse>
# Vérification : php artisan doctrack:mail-test vous@exemple.sn --all
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── DocTrack ──────────────────────────────────────────────
# Générer une fois avec : php artisan jwt:secret   (ne jamais régénérer en production)
JWT_SECRET=
JWT_TTL=60
FRONTEND_URL=https://sendoctrack.netlify.app
QR_CODE_VALIDITY_MONTHS=12

# Clé de hachage des numéros de pièce / téléphones (générer : php -r "echo bin2hex(random_bytes(32));")
# À fixer une fois pour toutes : la changer rend la recherche et le matching inopérants sur l'existant.
DOCTRACK_HASH_KEY=
# Page publique de vérification des certificats (lien du QR code). Défaut : APP_URL/verifier
CERTIFICATE_VERIFICATION_URL=
# Délai (heures) pendant lequel un agent peut annuler sa propre saisie
AGENT_CANCEL_WINDOW_HOURS=24

# SMS Orange (https://developer.orange.com) — ex. ORANGE_SENDER_ADDRESS=+2210000
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
ORANGE_SENDER_NAME=DocTrack

# Connexion Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Comptes créés par "php artisan db:seed" (mot de passe vide = généré et affiché)
SEED_ADMIN_EMAIL=admin@doctrack.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRSTNAME=Admin
SEED_ADMIN_LASTNAME=DocTrack
SEED_ADMIN_PHONE=+221700000000
SEED_DEMO_PASSWORD=
# Structures de test (annuaire ONLPL) : php artisan db:seed --class=PilotStructuresSeeder
# Structures pilotes qui reçoivent aussi deux comptes agents (identifiants du fichier database/data/structures_onlpl.json).
SEED_PILOT_STRUCTURES=SN-POL-001,SN-POL-008,SN-POL-055,SN-GEN-202

# ── Facturation (pilot = gratuit mais tracé ; live = tarifs appliqués) ──
BILLING_MODE=pilot
BILLING_ONLINE_PROVIDER=wave
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
PAYMENT_SUCCESS_URL=
PAYMENT_ERROR_URL=

# Documentation API V2 (/api/documentation/v2)
# Documentation Swagger : à laisser à false en production (elle donne la carte de toutes les routes).
API_DOCS_ENABLED=false

# ── Assistant conversationnel (texte + voix, FR + wolof) — voir ai/README.md ──
ASSISTANT_ENABLED=true
ASSISTANT_RETENTION_DAYS=30
# Voix → texte : none | hf_space (Space « doctrack-voice », Omnilingual ASR)
AI_STT_PROVIDER=none
AI_STT_URL=
AI_STT_TOKEN=
# Texte → voix wolof : none | hf_space (Space « doctrack-tts », modèle Adia_TTS de CONCREE, Apache 2.0).
# Ensuite : php artisan doctrack:assistant-voices  (prépare les MP3 des phrases de l'assistant)
AI_TTS_PROVIDER=none
AI_TTS_URL=
AI_TTS_TOKEN=
AI_TTS_TIMEOUT=300
# Modèle de langage de secours (facultatif) : none | gemini | openai_compatible
# Formule gratuite = données FICTIVES uniquement (le fournisseur peut s'en servir pour entraîner ses modèles).
AI_LLM_PROVIDER=none
GEMINI_API_KEY=
AI_LLM_URL=
AI_LLM_KEY=
AI_LLM_MODEL=
# Lecture des pièces (OCR) : none | hf_space (Space « doctrack-ocr », RapidOCR)
# Sur votre PC : lancez ai/doctrack-ocr/lancer_ocr.bat puis AI_OCR_PROVIDER=hf_space et AI_OCR_URL=http://127.0.0.1:7860
AI_OCR_PROVIDER=none
AI_OCR_URL=
AI_OCR_TOKEN=
# Masquer aussi les numéros des photos publiées sans scan préalable (appel OCR à chaque publication)
AI_OCR_MASK_ON_UPLOAD=false

# Rapports : synthèse rédigée par l'IA (chiffres agrégés uniquement, vérifiés, validés par le super admin)
AI_REPORTS_ENABLED=false
AI_REPORTS_PROVIDERS=qwen,glm
AI_REPORTS_REQUIRE_VALIDATION=true
# Alibaba Model Studio (international, Singapour) — payant pour les nouveaux comptes depuis le 29/10/2026
QWEN_API_KEY=
QWEN_MODEL=qwen-plus
# Z.ai (Zhipu) — GLM-4.7-Flash gratuit
GLM_API_KEY=
GLM_MODEL=glm-4.7-flash

# Assistant « Une question ? » : réponses rédigées par l'IA à partir de resources/assistant/base-de-connaissances.md
# Fournisseurs essayés dans l'ordre (vide = fiches seulement, aucun appel externe). Ex. : groq,glm,gemini
ASSISTANT_AI_PROVIDERS=
# Groq (gratuit, sans carte) — clé sur https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Google AI Studio (gratuit, sans carte) — clé sur https://aistudio.google.com/apikey (aussi utilisée par AI_LLM_PROVIDER=gemini)
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# OpenRouter (modèles « :free ») — clé sur https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-4.7-flash:free
DEEPSEEK_API_KEY=
