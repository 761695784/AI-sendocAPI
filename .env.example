APP_NAME=DocTrack
APP_ENV=local
APP_KEY=
# Toujours false en production (sinon les erreurs internes sont exposées)
APP_DEBUG=true
APP_TIMEZONE=Africa/Dakar
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── DocTrack ──────────────────────────────────────────────
# Générer une fois avec : php artisan jwt:secret   (ne jamais régénérer en production)
JWT_SECRET=
JWT_TTL=60
FRONTEND_URL=https://sendoctrack.netlify.app
QR_CODE_VALIDITY_MONTHS=12

# Clé de hachage des numéros de pièce / téléphones (générer : php -r "echo bin2hex(random_bytes(32));")
# À fixer une fois pour toutes : la changer rend la recherche et le matching inopérants sur l'existant.
DOCTRACK_HASH_KEY=
# Page publique de vérification des certificats (lien du QR code). Défaut : APP_URL/verifier
CERTIFICATE_VERIFICATION_URL=
# Délai (heures) pendant lequel un agent peut annuler sa propre saisie
AGENT_CANCEL_WINDOW_HOURS=24

# SMS Orange (https://developer.orange.com) — ex. ORANGE_SENDER_ADDRESS=+2210000
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
ORANGE_SENDER_ADDRESS=
ORANGE_SENDER_NAME=DocTrack

# Connexion Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Comptes créés par "php artisan db:seed" (mot de passe vide = généré et affiché)
SEED_ADMIN_EMAIL=admin@doctrack.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRSTNAME=Admin
SEED_ADMIN_LASTNAME=DocTrack
SEED_ADMIN_PHONE=+221700000000
SEED_DEMO_PASSWORD=
