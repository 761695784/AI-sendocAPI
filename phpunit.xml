<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Les tests d'images et d'OCR manipulent des photos de plusieurs Mo : 128 Mo ne suffisent pas. -->
        <ini name="memory_limit" value="1024M"/>
        <ini name="max_execution_time" value="0"/>
        <env name="APP_ENV" value="testing"/>
        <!-- Adresses fixes : les tests ne dépendent pas des adresses du .env (local ou en ligne). -->
        <env name="APP_URL" value="http://localhost"/>
        <env name="FRONTEND_URL" value="https://doctrack.test"/>
        <env name="CERTIFICATE_VERIFICATION_URL" value="https://doctrack.test/verifier"/>
        <env name="APP_LOCALE" value="fr"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="FILESYSTEM_DISK" value="local"/>
        <env name="JWT_SECRET" value="testing-secret-key-for-phpunit-only-0123456789abcdef"/>
        <env name="ORANGE_CLIENT_ID" value=""/>
        <env name="ORANGE_CLIENT_SECRET" value=""/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
